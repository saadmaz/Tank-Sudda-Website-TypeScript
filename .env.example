# Copy to .env.local for local development. Never commit real values.
# These values are read at BUILD time (pages are statically generated), so
# set them in your hosting provider before building/deploying.
# Cloudflare: Worker → Settings → Variables and secrets (keys as secrets).
# Local Cloudflare preview (`bun run cf:preview`) reads .dev.vars instead.

# --- Site origin (required for indexing) ---------------------------------
# The verified production domain, with no trailing path. Until this is set the
# site emits no canonical URLs, an empty sitemap and robots "Disallow: /".
NEXT_PUBLIC_SITE_URL=

# Set to 1 on staging/preview deployments to keep them out of search results.
SITE_NOINDEX=

# Google Search Console HTML-tag verification token (content value only).
GOOGLE_SITE_VERIFICATION=

# --- Booking and contact form delivery (at least one channel) ------------
# Email via Resend (https://resend.com). The FROM address must be on a domain
# verified in Resend. LEAD_EMAIL_TO accepts a comma-separated list.
RESEND_API_KEY=
LEAD_EMAIL_FROM=
LEAD_EMAIL_TO=

# JSON webhook (must be https). Optional secret signs the body with
# HMAC-SHA256 in the X-TankSudda-Signature header.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# --- Analytics (optional) ---------------------------------------------------
# Plausible (cookieless) site domain, e.g. tanksudda.com. Leave empty for no analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
