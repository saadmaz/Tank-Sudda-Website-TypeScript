{
  "name": "tank-sudda-website",
  "version": "1.0.0",
  "description": "Website and booking system for Tank Sudda, water tank and sump cleaning in Sri Lanka, in English, Sinhala and Tamil.",
  "homepage": "https://tanksudda.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saadmaz/Tank-Sudda-Website-TypeScript.git"
  },
  "bugs": {
    "url": "https://github.com/saadmaz/Tank-Sudda-Website-TypeScript/issues"
  },
  "author": "Saad Mazhar (https://github.com/saadmaz)",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run content && next dev",
    "build": "bun run content && next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "illustrations": "bun scripts/generate-illustrations.tsx",
    "content": "bun scripts/generate-article-index.ts",
    "email-icons": "bun scripts/generate-email-icons.tsx",
    "brand": "bun scripts/generate-brand-assets.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@mdx-js/mdx": "^3.1.1",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opennextjs/cloudflare": "1.20.10",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "4.149.0"
  },
  "patchedDependencies": {
    "@opennextjs/cloudflare@1.20.10": "patches/@opennextjs%2Fcloudflare@1.20.10.patch"
  }
}
