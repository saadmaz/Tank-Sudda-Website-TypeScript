// Cloudflare Workers configuration for tanksudda.com (built with @opennextjs/cloudflare).
// Deploy: `bun run cf:deploy`, or connect the GitHub repo in Workers Builds.
// Secrets (RESEND_API_KEY, LEAD_WEBHOOK_SECRET) are set in the Cloudflare dashboard,
// never here. See docs/CONFIGURATION.md → "Hosting on Cloudflare".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tank-sudda-website-typescript",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Preview URLs add a hidden, read-only *.tanksudda.com record that answers every other proxied
  // subdomain with a 404, ahead of real DNS records and the tank-sudda-maintenance route.
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // Runtime settings that are not secret. Every deploy replaces the Worker's plain-text
  // variables with these, so they live here rather than in the dashboard.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://tanksudda.com",
    "LEAD_EMAIL_FROM": "Tank Sudda <info@tanksudda.com>",
    // Contact form messages.
    "LEAD_EMAIL_TO": "tanksuddaglobal@gmail.com",
    // Booking requests (comma-separated).
    "LEAD_BOOKING_EMAIL_TO": "sales.tanksudda@gmail.com, tanksuddaglobal@gmail.com",
  },
  // Keep anything else added in the dashboard (secrets are always kept).
  "keep_vars": true,
}
